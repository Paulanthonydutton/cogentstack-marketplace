{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cogentstack.app/schemas/desktop-marketplace-v1.json",
  "title": "CogentStack Desktop Git marketplace release",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "application",
    "latestVersion",
    "minimumSupportedVersion",
    "releaseTag",
    "releasePageUrl",
    "releaseNotes",
    "windows"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "application": { "const": "CogentStack Desktop" },
    "latestVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "minimumSupportedVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "releaseTag": { "type": "string", "pattern": "^desktop-v[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "releasePageUrl": {
      "type": "string",
      "pattern": "^https://github\\.com/Paulanthonydutton/cogentstack-marketplace/releases/tag/desktop-v[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "releaseNotes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1, "maxLength": 240 }
    },
    "windows": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "architecture",
        "installerUrl",
        "installerSha256",
        "installerSizeBytes",
        "authenticodeSigned",
        "requiresUserApproval",
        "automaticLaunch"
      ],
      "properties": {
        "architecture": { "const": "x64" },
        "installerUrl": {
          "type": "string",
          "pattern": "^https://github\\.com/Paulanthonydutton/cogentstack-marketplace/releases/download/desktop-v[0-9]+\\.[0-9]+\\.[0-9]+/CogentStack-Desktop-[0-9]+\\.[0-9]+\\.[0-9]+-x64-setup\\.exe$"
        },
        "installerSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "installerSizeBytes": { "type": "integer", "minimum": 1 },
        "authenticodeSigned": { "type": "boolean" },
        "requiresUserApproval": { "const": true },
        "automaticLaunch": { "const": false }
      }
    }
  }
}
